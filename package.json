{
  "name": "komet-streaming",
  "version": "0.1.0",
  "description": "BMK Komet multi-court streaming control plane: match/score state, overlays, and real-time updates for OBS.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run build && npm run test:coverage"
  },
  "dependencies": {
    "better-sqlite3": "11.3.0",
    "cookie-session": "2.1.0",
    "express": "4.21.0",
    "socket.io": "4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/cookie-session": "2.0.49",
    "@types/express": "4.17.21",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.0.5",
    "tsx": "4.16.2",
    "supertest": "7.0.0",
    "typescript": "5.5.3",
    "vitest": "2.0.5"
  }
}
